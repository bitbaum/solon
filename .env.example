# Copy to .env and fill in. Nothing here is a real secret.

# --- Required ---------------------------------------------------------------

# PostgreSQL. `npm run db:migrate` creates the schema against this.
DATABASE_URL="postgresql://solon:solon@localhost:5432/solon"

# NextAuth v5. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The app's own public origin. NextAuth infers this from request headers, which
# is wrong behind a reverse proxy — pin it in every deployed environment or
# sign-in redirects land on the internal host instead of the public one.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sign in with OrangeCat (optional locally, required in production) -------
# Solon delegates identity to OrangeCat's OAuth provider.
ORANGECAT_OAUTH_ISSUER="https://orangecat.ch"
ORANGECAT_OAUTH_CLIENT_ID=""
ORANGECAT_OAUTH_CLIENT_SECRET=""

# --- Founder of a seeded organization ---------------------------------------
# An organization founded through /orgs/new seats its founder in the same step.
# Organization #1 was seeded by a migration with no human seat; its founding
# seat may be claimed ONLY by this OrangeCat actor id (shown at /account once
# signed in). Unset, the seat is closed to everyone and /join says so.
SOLON_FOUNDER_ACTOR_ID=""

# --- Optional ---------------------------------------------------------------

# Watch-only treasury balances are read from a mempool.space-compatible API.
# Defaults to the public instance when unset.
MEMPOOL_API_BASE="https://mempool.space/api"

# Where `pnpm run places:import` keeps each source's raw bytes, under their
# sha256, so every imported number links back to what the source published.
# Defaults to ./data/snapshots. On the box, point it at persistent storage
# outside the release directory.
PLACES_SNAPSHOT_DIR=""

# Outbound notification of a recorded decision (OrangeCat re-verifies the
# signatures itself; this only tells it there is something new to read).
SOLON_WEBHOOK_URL=""
# Also verifies the grant Loki attaches when a project owner founds an
# organization from their project page (src/lib/loki-grant.ts). Must equal
# Loki's SOLON_WEBHOOK_SECRET. Unset, founding still works — it just cannot be
# attributed to a project.
SOLON_WEBHOOK_SECRET=""
