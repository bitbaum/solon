{
  "name": "solon",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build/vendor-maplibre.mjs && next dev",
    "build": "node scripts/build/vendor-maplibre.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/design-system-check.js",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run design:check && pnpm run check:places-literals && pnpm run test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:puppeteer": "BASE_URL=${BASE_URL:-http://localhost:3000} node tests/puppeteer/smoke.mjs",
    "test:puppeteer:mega": "BASE_URL=${BASE_URL:-http://localhost:3000} node tests/puppeteer/mega-menu.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check:vendored-drift": "node scripts/check-vendored-drift.mjs",
    "places:sync-config": "tsx scripts/places-sync-config.ts",
    "places:import": "tsx scripts/places-import.ts",
    "places:fetch": "tsx scripts/places-fetch.ts",
    "check:places-literals": "node --import tsx scripts/check-places-no-literals.ts"
  },
  "dependencies": {
    "@bitbaum/accountkit": "github:bitbaum/accountkit#v0.2.0",
    "@bitbaum/geo-kit": "github:bitbaum/geo-kit#a337aec928cf7804fecf459c308d366b90f4b2fa",
    "@fleet/design-tokens": "github:bitbaum/design-tokens#c93f7b2662b25284c6a45729c1b71047e21c81fe",
    "@noble/hashes": "2.4.0",
    "@noble/secp256k1": "3.2.0",
    "@scure/base": "^2.4.0",
    "bip-kit": "^0.6.0",
    "bs58check": "^4.0.0",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "26.6.4",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "espree": "^11.2.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "puppeteer": "25.12.0",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
