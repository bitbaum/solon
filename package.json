{
  "name": "solon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/design-system-check.js",
    "verify": "npm run lint && npm run typecheck && npm run design:check && npm run test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:puppeteer": "BASE_URL=${BASE_URL:-http://localhost:3000} node tests/puppeteer/smoke.mjs",
    "test:puppeteer:mega": "BASE_URL=${BASE_URL:-http://localhost:3000} node tests/puppeteer/mega-menu.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@fleet/design-tokens": "github:maonakamoto/design-tokens#v1.1.0",
    "@noble/hashes": "2.3.0",
    "@noble/secp256k1": "3.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scure/base": "^2.3.0",
    "bs58check": "^4.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "puppeteer": "25.8.0",
    "ts-node": "10.9.2",
    "tsx": "^4.23.12",
    "typescript": "5.5.3",
    "vitest": "^4.1.11"
  }
}
